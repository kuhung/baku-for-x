# Local Node Flywheel Server (same core as Cloudflare Worker)
PORT=8787
HOST=127.0.0.1
SQLITE_FILE=server/data/flywheel.sqlite

# Optional Bearer Token (leave empty for public frictionless flywheel)
API_AUTH_TOKEN=

# Two-tier Flywheel Thresholds
BLACKLIST_REPORT_QUORUM=2
POST_REPORT_QUORUM=2
ACCOUNT_ESCALATION_THRESHOLD=3

# Passwordless Anti-Abuse Quotas
AI_DAILY_ITEM_LIMIT=5000
IP_MINUTE_ITEM_LIMIT=120
IP_DAILY_ITEM_LIMIT=800
ALLOW_PUBLIC_CLASSIFY=true
# IP_HASH_SALT=change-me-in-production

# Primary Cloud AI: Google Gemini Decision 1 (zero output tokens)
GEMINI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/decisions
# AI_MODEL=gemini-decision-1
